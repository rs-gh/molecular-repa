\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces \textbf  {REPA lifts the trunk's representation quality asymptotically.} REPA variants open a quality gap over baseline that never closes; the random control gains least, evidence of genuine transfer rather than regularisation. (Two representative REPA variants are shown, L9-GearNet and L9-MPNN; probe protocol and further ablations in Appendix\nobreakspace  {}\ref  {app:leakage}; each point is a mean over $3$ probe seeds, with the shaded band their min--max.)}}{42}{figure.6.3}}
\newlabel{fig:proteina-rep}{{6.3}{42}{\textbf {REPA lifts the trunk's representation quality asymptotically.} REPA variants open a quality gap over baseline that never closes; the random control gains least, evidence of genuine transfer rather than regularisation. (Two representative REPA variants are shown, L9-GearNet and L9-MPNN; probe protocol and further ablations in Appendix~\ref {app:leakage}; each point is a mean over $3$ probe seeds, with the shaded band their min--max.)}{figure.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.2}{\ignorespaces \textbf  {REPA's representation advantage is encoder-routed.} REPA-GearNet wins the fold probes (CATH C/A/T) decisively, while REPA-MPNN edges the per-residue probe (IF). The random control gains least and does not help IF, evidence of genuine structural transfer rather than regularisation. (Means over $n{=}3$ seeds at a single 1.0M checkpoint; the seed spread is small on IF and CATH (dihedral is noisier). Best-layer linear probe at $n_\text  {train}{=}1000$ (protocol in Appendix\nobreakspace  {}\ref  {app:leakage}). Per-seed ranges and the remaining variants are in Appendix Table\nobreakspace  {}\ref  {tab:proteina-rep-full}.)}}{42}{table.6.2}}
\newlabel{tab:proteina-rep}{{6.2}{42}{\textbf {REPA's representation advantage is encoder-routed.} REPA-GearNet wins the fold probes (CATH C/A/T) decisively, while REPA-MPNN edges the per-residue probe (IF). The random control gains least and does not help IF, evidence of genuine structural transfer rather than regularisation. (Means over $n{=}3$ seeds at a single 1.0M checkpoint; the seed spread is small on IF and CATH (dihedral is noisier). Best-layer linear probe at $n_\text {train}{=}1000$ (protocol in Appendix~\ref {app:leakage}). Per-seed ranges and the remaining variants are in Appendix Table~\ref {tab:proteina-rep-full}.)}{table.6.2}{}}

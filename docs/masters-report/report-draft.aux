\@writefile{lot}{\contentsline {table}{\numberline {A.4}{\ignorespaces \textbf  {On AFDB, REPA's representation gain concentrates on fold structure.} The AFDB counterpart to Table\nobreakspace  {}\ref  {tab:proteina-rep}: REPA-GearNet lifts the CATH fold probes as on PDB, so the fold routing replicates. The per-residue probes (IF, dihedral) show no consistent effect and are noise-dominated at this scale, so we lean on the fold result. ($n{\le }256$ AFDB-trained; best-layer linear probe at $n_\text  {train}{=}1000$ on the cross-database blinded set (App.\nobreakspace  {}\ref  {app:leakage}); single 1.0M checkpoint, $n{=}1$ seed; $\Delta $ from baseline. $^{\ddagger }$Random control at its 500K last checkpoint.)}}{63}{table.A.4}}
\newlabel{tab:proteina-rep-afdb}{{A.4}{63}{\textbf {On AFDB, REPA's representation gain concentrates on fold structure.} The AFDB counterpart to Table~\ref {tab:proteina-rep}: REPA-GearNet lifts the CATH fold probes as on PDB, so the fold routing replicates. The per-residue probes (IF, dihedral) show no consistent effect and are noise-dominated at this scale, so we lean on the fold result. ($n{\le }256$ AFDB-trained; best-layer linear probe at $n_\text {train}{=}1000$ on the cross-database blinded set (App.~\ref {app:leakage}); single 1.0M checkpoint, $n{=}1$ seed; $\Delta $ from baseline. $^{\ddagger }$Random control at its 500K last checkpoint.)}{table.A.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.5}{\ignorespaces \textbf  {Every REPA variant raises per-residue alignment to all three encoders, including the two it was never aligned to.} Across-layer peak per-residue CKNNA (bootstrap median, $\times 10^{3}$), with the peak trunk layer as a superscript; $k{=}10$, step 1.0M, $n{\le }256$ PDB-trained. The $\dagger $ marks each model's own alignment target. Every REPA row exceeds the baseline in every column. This holds even for the two encoders each model was never aligned to (the non-$\dagger $ cells). We suggest the Platonic-convergence signature\nobreakspace  {}\cite  {PlatonicRep} as possibly being relevant in \S  \ref  {sec:proteina-alignment}. Absolute values are small (an order of magnitude below image-domain REPA), so we read the pattern, not the magnitude. ($n{=}1$ seed; bootstrap medians.)}}{63}{table.A.5}}
\newlabel{tab:cknna-matrix}{{A.5}{63}{\textbf {Every REPA variant raises per-residue alignment to all three encoders, including the two it was never aligned to.} Across-layer peak per-residue CKNNA (bootstrap median, $\times 10^{3}$), with the peak trunk layer as a superscript; $k{=}10$, step 1.0M, $n{\le }256$ PDB-trained. The $\dagger $ marks each model's own alignment target. Every REPA row exceeds the baseline in every column. This holds even for the two encoders each model was never aligned to (the non-$\dagger $ cells). We suggest the Platonic-convergence signature~\cite {PlatonicRep} as possibly being relevant in \S \ref {sec:proteina-alignment}. Absolute values are small (an order of magnitude below image-domain REPA), so we read the pattern, not the magnitude. ($n{=}1$ seed; bootstrap medians.)}{table.A.5}{}}

\@writefile{lot}{\contentsline {table}{\numberline {A.8}{\ignorespaces \textbf  {Under deterministic (ODE) sampling, REPA lifts the floor above the baseline on AFDB, while on PDB it redistributes it.} ODE sampling (no sampler noise) isolates the learned distribution. On AFDB the GearNet encoders and L9-MPNN raise both designability and distribution match (FPSD); L4-MPNN raises FPSD only. On PDB the trained encoders raise designability but worsen FPSD across the board --- the floor redistributes rather than lifts. Designable pwTM is the mean pairwise TM over the designable subset (higher $=$ more concentrated). (Absolute values at step 1.3M; REPA cells coloured for Des and FPSD only; $n{=}1$ seed; $1{,}125$ backbones/seed, $250$ for designability. $^{\ast }$AFDB L4-random has no checkpoint past 800K.)}}{62}{table.A.8}}
\newlabel{tab:proteina-ode}{{A.8}{62}{\textbf {Under deterministic (ODE) sampling, REPA lifts the floor above the baseline on AFDB, while on PDB it redistributes it.} ODE sampling (no sampler noise) isolates the learned distribution. On AFDB the GearNet encoders and L9-MPNN raise both designability and distribution match (FPSD); L4-MPNN raises FPSD only. On PDB the trained encoders raise designability but worsen FPSD across the board --- the floor redistributes rather than lifts. Designable pwTM is the mean pairwise TM over the designable subset (higher $=$ more concentrated). (Absolute values at step 1.3M; REPA cells coloured for Des and FPSD only; $n{=}1$ seed; $1{,}125$ backbones/seed, $250$ for designability. $^{\ast }$AFDB L4-random has no checkpoint past 800K.)}{table.A.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.9}{\ignorespaces \textbf  {Per-seed min--max spread behind the 1.3M centerpiece (Table\nobreakspace  {}\ref  {tab:proteina-13m}).} Min--max range across generation seeds 42/1042/2042 (default sde sampler $n{=}0.45$), absolute units; the centerpiece reports their mean. Columns match the centerpiece: T-W is (fJSD-A, fS-A), T-D is pwTM, S-W is ssJSD2D\nobreakspace  {}(W), S-D is ssJSD2D\nobreakspace  {}(D) and $\beta $\%. ($^{\dagger }$single seed, no range.)}}{62}{table.A.9}}
\newlabel{tab:proteina-13m-ranges}{{A.9}{62}{\textbf {Per-seed min--max spread behind the 1.3M centerpiece (Table~\ref {tab:proteina-13m}).} Min--max range across generation seeds 42/1042/2042 (default sde sampler $n{=}0.45$), absolute units; the centerpiece reports their mean. Columns match the centerpiece: T-W is (fJSD-A, fS-A), T-D is pwTM, S-W is ssJSD2D~(W), S-D is ssJSD2D~(D) and $\beta $\%. ($^{\dagger }$single seed, no range.)}{table.A.9}{}}

\newlabel{sec:proteina-genrep}{{6.2.3}{44}{In the short run, REPA accelerates generation quality in both experimental and synthetic data regimes}{subsection.6.2.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces \textbf  {Most REPA variants accelerate generation quality over the baseline.} In some regimes they also win the long run. Acceleration is the \%-delta vs the baseline at 400K (the anchor of Figure\nobreakspace  {}\ref  {fig:proteina-genrep}), with the absolute score in parentheses; the long run is each variant's absolute best, with the baseline capped at the furthest trained variant per regime (2.0M PDB, 1.5M AFDB), coloured against the baseline-best row. ($n{=}1$--$3$ seeds, seed-mean; $1{,}125$ backbones/seed, $250$ for designability.)}}{45}{table.6.3}}
\newlabel{tab:proteina-speedup}{{6.3}{45}{\textbf {Most REPA variants accelerate generation quality over the baseline.} In some regimes they also win the long run. Acceleration is the \%-delta vs the baseline at 400K (the anchor of Figure~\ref {fig:proteina-genrep}), with the absolute score in parentheses; the long run is each variant's absolute best, with the baseline capped at the furthest trained variant per regime (2.0M PDB, 1.5M AFDB), coloured against the baseline-best row. ($n{=}1$--$3$ seeds, seed-mean; $1{,}125$ backbones/seed, $250$ for designability.)}{table.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.4}{\ignorespaces \textbf  {REPA's early-training acceleration holds across the sampler-noise axis.} The representative REPA variant per dataset beats the baseline on both FPSD and designability at almost every $\gamma $; the lone exception is PDB FPSD at the degenerate $\gamma {=}0$. (Absolute values at step 400K; $n{=}3$ seeds at $\gamma {=}0.45$ [2 for AFDB], else $n{=}1$; $1{,}125$ backbones/seed, $250$ for designability.)}}{46}{table.6.4}}
\newlabel{tab:proteina-sampler}{{6.4}{46}{\textbf {REPA's early-training acceleration holds across the sampler-noise axis.} The representative REPA variant per dataset beats the baseline on both FPSD and designability at almost every $\gamma $; the lone exception is PDB FPSD at the degenerate $\gamma {=}0$. (Absolute values at step 400K; $n{=}3$ seeds at $\gamma {=}0.45$ [2 for AFDB], else $n{=}1$; $1{,}125$ backbones/seed, $250$ for designability.)}{table.6.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.5}{\ignorespaces \textbf  {Better trunk representations track better generation --- strongly for designability, moderately for FPSD.} Partial Pearson correlation controlling for training step, with the raw value alongside; oriented so a positive value means better representation accompanies better generation. ($n{=}59$ checkpoints, one per variant and training step, pooled over the baseline, the REPA variants, and the random control; each contributes a single (representation, generation) point, with generation seed-averaged to one value ($3$ seeds, single-seed at the late tail) and the probe read at one seed. $1{,}125$ backbones/seed, $250$ for designability.)}}{46}{table.6.5}}
\newlabel{tab:proteina-genrep-corr}{{6.5}{46}{\textbf {Better trunk representations track better generation --- strongly for designability, moderately for FPSD.} Partial Pearson correlation controlling for training step, with the raw value alongside; oriented so a positive value means better representation accompanies better generation. ($n{=}59$ checkpoints, one per variant and training step, pooled over the baseline, the REPA variants, and the random control; each contributes a single (representation, generation) point, with generation seed-averaged to one value ($3$ seeds, single-seed at the late tail) and the probe read at one seed. $1{,}125$ backbones/seed, $250$ for designability.)}{table.6.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces \textbf  {At equal compute, our strongest variant achieves better representation and generation quality.} The dashed arrow marks the matched-compute comparison at step 400K. Against the baseline, the strongest PDB variant (REPA-L9-MPNN) has higher fold accuracy (CATH-A) and better generation: lower FPSD (a) and higher designability (b). (Markers are a coarse $\approx $400K-spaced subset of checkpoints from 100K, with the 400K point bordered; $x$ = student CATH-A accuracy, higher to the right; generation $n{=}3$ seeds, except the single-seed tail checkpoint on each trajectory; probe single-seed; $1{,}125$ backbones/seed, $250$ for designability.)}}{47}{figure.6.5}}
\newlabel{fig:proteina-genrep}{{6.5}{47}{\textbf {At equal compute, our strongest variant achieves better representation and generation quality.} The dashed arrow marks the matched-compute comparison at step 400K. Against the baseline, the strongest PDB variant (REPA-L9-MPNN) has higher fold accuracy (CATH-A) and better generation: lower FPSD (a) and higher designability (b). (Markers are a coarse $\approx $400K-spaced subset of checkpoints from 100K, with the 400K point bordered; $x$ = student CATH-A accuracy, higher to the right; generation $n{=}3$ seeds, except the single-seed tail checkpoint on each trajectory; probe single-seed; $1{,}125$ backbones/seed, $250$ for designability.)}{figure.6.5}{}}

\citation{REPA}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Representative molecules generated by Tabasco's baseline and two REPA variants (CheMeleon, MACE). All are valid, connected, and drug-like, illustrating the saturated structural-quality surface that leaves REPA no headroom (\S  \ref  {sec:tabasco-diagnosis}).}}{33}{figure.5.2}}
\newlabel{fig:tabasco-gallery}{{5.2}{33}{Representative molecules generated by Tabasco's baseline and two REPA variants (CheMeleon, MACE). All are valid, connected, and drug-like, illustrating the saturated structural-quality surface that leaves REPA no headroom (\S \ref {sec:tabasco-diagnosis})}{figure.5.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces \textbf  {REPA brings no measurable generation quality gain over the baseline.} The quality metrics are saturated, sitting at or near their ceiling for baseline and variants alike. On FCD, the only metric with headroom, every REPA run is worse. The MACE \emph  {tradeoff} row replaces the additive REPA loss with a convex one (\S  \ref  {sec:tabasco-diagnosis}). (1{,}000 sampled molecules; higher-is-better except FCD ($\delimiter "3223379 $). \emph  {Steps} is the training step at evaluation; the baseline trained ${\sim }2{\times }$ longer, but the quality metrics plateau early, so the unequal steps do not make the comparison unfair (\S  \ref  {sec:tabasco-results}); $n{=}1$ seed, one run per variant.)}}{33}{table.5.2}}
\newlabel{tab:tabasco-gen}{{5.2}{33}{\textbf {REPA brings no measurable generation quality gain over the baseline.} The quality metrics are saturated, sitting at or near their ceiling for baseline and variants alike. On FCD, the only metric with headroom, every REPA run is worse. The MACE \emph {tradeoff} row replaces the additive REPA loss with a convex one (\S \ref {sec:tabasco-diagnosis}). (1{,}000 sampled molecules; higher-is-better except FCD ($\downarrow $). \emph {Steps} is the training step at evaluation; the baseline trained ${\sim }2{\times }$ longer, but the quality metrics plateau early, so the unequal steps do not make the comparison unfair (\S \ref {sec:tabasco-results}); $n{=}1$ seed, one run per variant.)}{table.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces \textbf  {REPA does not accelerate generation quality over the baseline.} Generation quality on GEOM-drugs (100 molecules sampled per epoch during training), plotted over training step across the range all three runs reach. The baseline and both REPA variants track together and reach near-ceiling on every axis within the first few thousand steps, leaving no headroom for alignment to fill. The metric is the in-training estimate, so values differ slightly from the final-checkpoint evaluation of Table\nobreakspace  {}\ref  {tab:tabasco-gen}. ($n{=}1$ seed, one run per variant.)}}{34}{figure.5.3}}
\newlabel{fig:tabasco-curves}{{5.3}{34}{\textbf {REPA does not accelerate generation quality over the baseline.} Generation quality on GEOM-drugs (100 molecules sampled per epoch during training), plotted over training step across the range all three runs reach. The baseline and both REPA variants track together and reach near-ceiling on every axis within the first few thousand steps, leaving no headroom for alignment to fill. The metric is the in-training estimate, so values differ slightly from the final-checkpoint evaluation of Table~\ref {tab:tabasco-gen}. ($n{=}1$ seed, one run per variant.)}{figure.5.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}Discussion}{34}{section.5.3}}
\newlabel{sec:tabasco-diagnosis}{{5.3}{34}{Discussion}{section.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces \textbf  {Linear-probe $R^2$ reveals little representational difference between REPA and the baseline.} The baseline trunk already captures what CheMeleon learns, while MACE's embedding is too narrow to decode these descriptors. Hence, neither makes for a usable REPA target. ($R^2$ for four RDKit descriptors, on held-out molecules; \S  \ref  {sec:tabasco-metrics}; $n{=}1$ seed.)}}{35}{table.5.3}}
\newlabel{tab:tabasco-probe}{{5.3}{35}{\textbf {Linear-probe $R^2$ reveals little representational difference between REPA and the baseline.} The baseline trunk already captures what CheMeleon learns, while MACE's embedding is too narrow to decode these descriptors. Hence, neither makes for a usable REPA target. ($R^2$ for four RDKit descriptors, on held-out molecules; \S \ref {sec:tabasco-metrics}; $n{=}1$ seed.)}{table.5.3}{}}

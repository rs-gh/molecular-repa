\newlabel{tab:setup-datasets}{{A.1}{56}{Properties of the two datasets we study, at the headline $n{\le }256$ regime. Sequence identity is computed with MMseqs2~\cite {MMseqs2} (\texttt {easy-search}, $\ge $30\% identity over $\ge $80\% alignment coverage)}{table.A.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces \textbf  {We read fold-level representation quality off CATH \emph  {architecture} --- Class is too coarse to discriminate, Topology too finely-bucketed to probe reliably.} Class has 4 buckets (one at 55\%, baseline already 0.73); Topology has $\sim $1400 imbalanced buckets; Architecture sits between --- enough classes to be meaningful, enough examples per class to be learnable --- so CATH-A is our headline fold metric (C and T are reported in the appendix). (``Baseline probe acc.'' is a linear probe on the un-aligned trunk.)}}{57}{table.A.2}}
\newlabel{tab:setup-cath}{{A.2}{57}{\textbf {We read fold-level representation quality off CATH \emph {architecture} --- Class is too coarse to discriminate, Topology too finely-bucketed to probe reliably.} Class has 4 buckets (one at 55\%, baseline already 0.73); Topology has $\sim $1400 imbalanced buckets; Architecture sits between --- enough classes to be meaningful, enough examples per class to be learnable --- so CATH-A is our headline fold metric (C and T are reported in the appendix). (``Baseline probe acc.'' is a linear probe on the un-aligned trunk.)}{table.A.2}{}}

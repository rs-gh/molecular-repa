\@writefile{lot}{\contentsline {table}{\numberline {6.6}{\ignorespaces \textbf  {On AFDB, REPA lifts the whole-set distribution cleanly; on PDB, the whole-set gains come with a more concentrated designable subset.} We compare rows within a data regime block, not across them. FPSD uses the training dataset as its reference in each case. Each cell is a mean over generation seeds; the per-seed min--max range is in Appendix\nobreakspace  {}\ref  {app:13m-ranges} (Table\nobreakspace  {}\ref  {tab:proteina-13m-ranges}). (Rows tagged with a step, e.g.\ \textit  {\relax \fontsize  {8}{9.5}\selectfont  (1.0M)}, show that variant's latest available checkpoint; $n{=}3$ seeds, except PDB L9-GearNet and AFDB L4-MPNN, $n{=}1$; $1{,}125$ backbones/seed, $250$ for designability.)}}{48}{table.6.6}}
\newlabel{tab:proteina-13m}{{6.6}{48}{\textbf {On AFDB, REPA lifts the whole-set distribution cleanly; on PDB, the whole-set gains come with a more concentrated designable subset.} We compare rows within a data regime block, not across them. FPSD uses the training dataset as its reference in each case. Each cell is a mean over generation seeds; the per-seed min--max range is in Appendix~\ref {app:13m-ranges} (Table~\ref {tab:proteina-13m-ranges}). (Rows tagged with a step, e.g.\ \textit {\scriptsize (1.0M)}, show that variant's latest available checkpoint; $n{=}3$ seeds, except PDB L9-GearNet and AFDB L4-MPNN, $n{=}1$; $1{,}125$ backbones/seed, $250$ for designability.)}{table.6.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces \textbf  {On experimental data, REPA enriches the designable set for $\beta $-strand folds.} Designable backbones at 1.3M steps on experimental (PDB) data, coloured by secondary structure: baseline (top), REPA-L9-MPNN (bottom). Both produce helical folds, but REPA additionally yields $\beta $-rich folds (gold) the baseline rarely does, raising the designable $\beta $-strand fraction (Table\nobreakspace  {}\ref  {tab:proteina-13m}).}}{49}{figure.6.6}}
\newlabel{fig:proteina-enrichment}{{6.6}{49}{\textbf {On experimental data, REPA enriches the designable set for $\beta $-strand folds.} Designable backbones at 1.3M steps on experimental (PDB) data, coloured by secondary structure: baseline (top), REPA-L9-MPNN (bottom). Both produce helical folds, but REPA additionally yields $\beta $-rich folds (gold) the baseline rarely does, raising the designable $\beta $-strand fraction (Table~\ref {tab:proteina-13m})}{figure.6.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.7}{\ignorespaces \textbf  {On PDB, REPA concentrates the $\beta $-rich designable folds onto fewer modes; on AFDB it does not.} The effect is specific to the most $\beta $-rich bin ($\beta {\ge }25$): PDB-L9-MPNN climbs from $0.29$ (400K) to $0.69$ (1.3M) while the baseline diversifies to $0.13$. Lower-$\beta $ bins and AFDB-L4-GearNet barely move. Designable-subset pairwise TM, lower\tmspace  +\thinmuskip {.1667em}=\tmspace  +\thinmuskip {.1667em}more diverse; columns bin by $\beta $-strand fraction (\%). Cells pool the designable subset across all available seeds (2--3 per cell) and the five generation lengths. The $\beta {\ge }25$ concentration at 1.3M rests on $n{=}188$ designable backbones for REPA-L9-MPNN against $n{=}20$ for the baseline, so the $0.69$ is not a small-sample artifact.}}{49}{table.6.7}}
\newlabel{tab:proteina-concentration}{{6.7}{49}{\textbf {On PDB, REPA concentrates the $\beta $-rich designable folds onto fewer modes; on AFDB it does not.} The effect is specific to the most $\beta $-rich bin ($\beta {\ge }25$): PDB-L9-MPNN climbs from $0.29$ (400K) to $0.69$ (1.3M) while the baseline diversifies to $0.13$. Lower-$\beta $ bins and AFDB-L4-GearNet barely move. Designable-subset pairwise TM, lower\,=\,more diverse; columns bin by $\beta $-strand fraction (\%). Cells pool the designable subset across all available seeds (2--3 per cell) and the five generation lengths. The $\beta {\ge }25$ concentration at 1.3M rests on $n{=}188$ designable backbones for REPA-L9-MPNN against $n{=}20$ for the baseline, so the $0.69$ is not a small-sample artifact}{table.6.7}{}}

\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Molecule encoder profiles. Neither encoder shows promise. \emph  {token-ID}: atom-type linear-probe accuracy (trivially $1.00$ for both; uninformative). \emph  {3D}: cosine self-similarity across conformers (lower $=$ more 3D-sensitive). \emph  {Floor}: constant-prediction cosine (high $=$ saturated). \emph  {Lift}: the rise a same-form MLP gains above the floor from cheap inputs. \emph  {Sparsity}: fraction of exact zeros.}}{28}{table.4.2}}
\newlabel{tab:profiling-mol}{{4.2}{28}{Molecule encoder profiles. Neither encoder shows promise. \emph {token-ID}: atom-type linear-probe accuracy (trivially $1.00$ for both; uninformative). \emph {3D}: cosine self-similarity across conformers (lower $=$ more 3D-sensitive). \emph {Floor}: constant-prediction cosine (high $=$ saturated). \emph {Lift}: the rise a same-form MLP gains above the floor from cheap inputs. \emph {Sparsity}: fraction of exact zeros}{table.4.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces Protein encoder profiles. GearNet and ProteinMPNN show promise. \emph  {AA-probe}: residue-identity linear-probe accuracy (high $=$ an identity lookup the generator already has). \emph  {3D}: cosine self-similarity after a 1\tmspace  +\thinmuskip {.1667em}\r A{} perturbation (lower $=$ more 3D-sensitive; N/A for sequence-only ESM2. \emph  {Floor}: constant-prediction cosine (high $=$ saturated). \emph  {Lift}: the rise a same-form MLP gains above the floor from cheap inputs. \emph  {RankMe}: Roy--Vetterli effective rank out of \emph  {Dim}\nobreakspace  {}\cite  {RankMe}. \textsuperscript  {\dag  }ESM2's lift is the largest here but is sequence context, not 3D: off-task.}}{28}{table.4.3}}
\newlabel{tab:profiling-protein}{{4.3}{28}{Protein encoder profiles. GearNet and ProteinMPNN show promise. \emph {AA-probe}: residue-identity linear-probe accuracy (high $=$ an identity lookup the generator already has). \emph {3D}: cosine self-similarity after a 1\,\AA {} perturbation (lower $=$ more 3D-sensitive; N/A for sequence-only ESM2. \emph {Floor}: constant-prediction cosine (high $=$ saturated). \emph {Lift}: the rise a same-form MLP gains above the floor from cheap inputs. \emph {RankMe}: Roy--Vetterli effective rank out of \emph {Dim}~\cite {RankMe}. \textsuperscript {\dag }ESM2's lift is the largest here but is sequence context, not 3D: off-task}{table.4.3}{}}

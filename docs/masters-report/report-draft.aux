\@writefile{lot}{\contentsline {table}{\numberline {A.7}{\ignorespaces \textbf  {Secondary-structure composition of the designable subset (step 700K, $\gamma {=}0.45$).} Mean strand ($f_E$) and helix ($f_H$) fractions over the designable backbones, $\pm $ half the seed range. GearNet shifts the designable subset toward strand and away from helix; MPNN on AFDB does the reverse. The AFDB L9-GearNet vs.\ L9-MPNN ranges are non-overlapping on both axes. The strand column ($f_E$) is the designable $\beta $-strand fraction underlying the centerpiece $\beta $-strand\tmspace  +\thinmuskip {.1667em}\% column (Table\nobreakspace  {}\ref  {tab:proteina-13m}), reported here per-seed and at 700K. (AFDB L4-MPNN omitted: no multi-seed $\gamma {=}0.45$ data; $2$--$3$ seeds per row, given in the Seeds column; $250$ backbones/seed (designable subset).)}}{61}{table.A.7}}
\newlabel{tab:ss-composition}{{A.7}{61}{\textbf {Secondary-structure composition of the designable subset (step 700K, $\gamma {=}0.45$).} Mean strand ($f_E$) and helix ($f_H$) fractions over the designable backbones, $\pm $ half the seed range. GearNet shifts the designable subset toward strand and away from helix; MPNN on AFDB does the reverse. The AFDB L9-GearNet vs.\ L9-MPNN ranges are non-overlapping on both axes. The strand column ($f_E$) is the designable $\beta $-strand fraction underlying the centerpiece $\beta $-strand\,\% column (Table~\ref {tab:proteina-13m}), reported here per-seed and at 700K. (AFDB L4-MPNN omitted: no multi-seed $\gamma {=}0.45$ data; $2$--$3$ seeds per row, given in the Seeds column; $250$ backbones/seed (designable subset).)}{table.A.7}{}}

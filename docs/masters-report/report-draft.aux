\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces \textbf  {REPA aligns the trunk with domain encoders, including those it was not trained with.} (a) Each REPA variant lifts per-residue alignment to its own target encoder above the baseline floor. (b) REPA induces cross-encoder alignment: for example, a GearNet-aligned trunk also moves toward ProteinMPNN and ESM2. Absolute alignment is small throughout, so we read the pattern, not its magnitude. (Step 1M, $t{=}1.0$; per-residue CKNNA, $k{=}10$; lines are bootstrap medians, shaded bands the 5--95\% subsample bootstrap interval; $n{=}1$ seed.)}}{44}{figure.6.4}}
\newlabel{fig:proteina-cknna}{{6.4}{44}{\textbf {REPA aligns the trunk with domain encoders, including those it was not trained with.} (a) Each REPA variant lifts per-residue alignment to its own target encoder above the baseline floor. (b) REPA induces cross-encoder alignment: for example, a GearNet-aligned trunk also moves toward ProteinMPNN and ESM2. Absolute alignment is small throughout, so we read the pattern, not its magnitude. (Step 1M, $t{=}1.0$; per-residue CKNNA, $k{=}10$; lines are bootstrap medians, shaded bands the 5--95\% subsample bootstrap interval; $n{=}1$ seed.)}{figure.6.4}{}}

# Personal, machine-local symlinks into /rds (per-user, never committed)
.local_ckpts

# Transient smoke-test outputs from the representation sweep harness
evaluation/proteina/representation/results/smoketest/

# Pretty-printed .json duplicates of canonical .jsonl sweep results — auto
# regenerated by the sweep harness, not tracked.
evaluation/proteina/representation/results/paper/**/pretrained_sweep_results.json

# Leakage-audit raw data (FASTAs + MMseqs2 m8 outputs, ~700 MB).
# Reproducible via train_overlap/run_all.sh; driver scripts ARE tracked.
evaluation/proteina/representation/results/inputs/leakage_audit/*.fasta
evaluation/proteina/representation/results/inputs/leakage_audit/*.m8
evaluation/proteina/representation/results/inputs/leakage_audit/train_overlap/*.fasta
evaluation/proteina/representation/results/inputs/leakage_audit/train_overlap/*.m8

# Representation: superseded/legacy result dirs and one-off legacy scripts.
# Kept on disk (move-only, not deleted) for one cycle in case anything needs
# to be recovered, but no longer tracked.
evaluation/proteina/representation/results/_archive/
evaluation/proteina/representation/scripts/_legacy/

# Vendored reference repos (frameflow, genie2, ...) — full git clones, never
# committed in-tree. Add as submodules if a stable revision is needed.
third_party/
eval_output.old_*
